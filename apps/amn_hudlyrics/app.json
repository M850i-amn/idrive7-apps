{
  "id": "amn_hudlyrics",
  "title": "HUD Lyrics",
  "description": "Synced lyrics for the song the car plays (Apple Music or Spotify over CarPlay), one line at a time. Step 1 build: the centre screen shows the song, the time in it and the lyric line, to prove the car's track and the lyrics lookup work before anything is drawn on the HUD. Read-only toward the car. Lyrics from LRCLIB (lrclib.net), its only internet host, through the Store's uplink.",
  "version": "0.1.0",
  "vendor": "amn",
  "loggingId": "OAH1",
  "internet": true,
  "signals": {
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": "*",
    "de.bmw.infotainment.entertainment.mediaplayer.MediaPlayer": "*",
    "de.bmw.infotainment.hmi.hmimediastate.HmiMediaState": "*",
    "de.bmw.infotainment.entertainment.dynamicmediaplayer.DynamicMediaPlayer": "*"
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "HUD Lyrics",
      "buttons": [
        ["BTN_SYNC", "Song just started"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {
      "key": "lines",
      "label": "Lines shown",
      "type": "choice",
      "default": "1",
      "options": [["1", "One line"], ["2", "Two lines (next one dim)"]]
    },
    {
      "key": "offset",
      "label": "Lyrics timing",
      "type": "number",
      "unit": "ms",
      "default": 0,
      "steps": [-3000, -2000, -1500, -1000, -750, -500, -250, 0, 250, 500, 750, 1000, 1500, 2000, 3000]
    },
    {
      "key": "theme",
      "label": "Colours",
      "type": "choice",
      "default": "m_tricolour",
      "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]
    }
  ]
}
